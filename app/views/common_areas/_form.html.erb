<%= form_with model: [building, common_area], class: "form" do |f| %>
  <%= render "shared/form_errors", object: common_area %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "Swimming pool", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 3, required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :capacity, class: "form-label" %>
      <%= f.number_field :capacity, class: "form-control", min: 1, required: true %>
    </div>
    <div class="form-group">
      <%= f.label :hourly_rate, "Hourly rate", class: "form-label" %>
      <%= f.number_field :hourly_rate, class: "form-control", step: "0.01", min: 0, required: true %>
      <span class="form-hint">Enter 0 to make this area free to book.</span>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", (common_area.persisted? ? [building, common_area] : building), class: "btn btn-ghost" %>
  </div>
<% end %>
