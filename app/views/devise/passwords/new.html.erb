<div class="auth-card">
  <h1>Forgot your password?</h1>
  <p class="auth-sub">Enter your email and we will send you reset instructions.</p>

  <%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :post, class: "form" do |f| %>
    <%= render "shared/form_errors", object: resource %>

    <div class="form-group">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
    </div>

    <div class="form-actions">
      <%= f.submit "Send reset instructions", class: "btn btn-primary btn-block" %>
    </div>
  <% end %>

  <div class="auth-links"><%= render "devise/shared/links" %></div>
</div>
