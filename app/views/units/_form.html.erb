<%= form_with model: [building, unit], class: "form" do |f| %>
  <%= render "shared/form_errors", object: unit %>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :unit_number, "Unit number", class: "form-label" %>
      <%= f.text_field :unit_number, class: "form-control", placeholder: "204", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :unit_type, class: "form-label" %>
      <%= f.select :unit_type, Unit::UNIT_TYPES.map { |t| [t.titleize, t] }, {}, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :bedrooms, class: "form-label" %>
      <%= f.number_field :bedrooms, class: "form-control", min: 0, required: true %>
    </div>
    <div class="form-group">
      <%= f.label :bathrooms, class: "form-label" %>
      <%= f.number_field :bathrooms, class: "form-control", min: 0, required: true %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :area, "Area (m²)", class: "form-label" %>
      <%= f.number_field :area, class: "form-control", step: "0.01", min: 0, required: true %>
    </div>
    <div class="form-group">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status, Unit::STATUSES.map { |s| [s.titleize, s] }, {}, class: "form-control" %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", (unit.persisted? ? [building, unit] : building), class: "btn btn-ghost" %>
  </div>
<% end %>
