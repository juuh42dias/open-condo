<%= form_with model: payment, class: "form" do |f| %>
  <%= render "shared/form_errors", object: payment %>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :unit_id, "Unit", class: "form-label" %>
      <%= f.collection_select :unit_id, units, :id, :label, { prompt: "Select a unit" }, class: "form-control", required: true %>
      <span class="form-hint">The charge is billed to the unit's resident or owner.</span>
    </div>
    <div class="form-group">
      <%= f.label :payment_type, "Type", class: "form-label" %>
      <%= f.select :payment_type, Payment::PAYMENT_TYPES.map { |t| [t.tr("_", " ").titleize, t] }, {}, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :amount, class: "form-label" %>
      <%= f.number_field :amount, class: "form-control", step: "0.01", min: 0, required: true %>
    </div>
    <div class="form-group">
      <%= f.label :due_date, class: "form-label" %>
      <%= f.date_field :due_date, class: "form-control", required: true %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_field :description, class: "form-control", placeholder: "Monthly condo fee — September", required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", payments_path, class: "btn btn-ghost" %>
  </div>
<% end %>
