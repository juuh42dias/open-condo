<%= form_with model: package, class: "form" do |f| %>
  <%= render "shared/form_errors", object: package %>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :unit_id, "Unit", class: "form-label" %>
      <%= f.collection_select :unit_id, units, :id, :label, { prompt: "Select a unit" }, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :recipient_name, "Recipient", class: "form-label" %>
      <%= f.text_field :recipient_name, class: "form-control", placeholder: "Resident full name", required: true %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :carrier, class: "form-label" %>
      <%= f.text_field :carrier, class: "form-control", placeholder: "UPS, FedEx, Correios…" %>
    </div>
    <div class="form-group">
      <%= f.label :sender, class: "form-label" %>
      <%= f.text_field :sender, class: "form-control", placeholder: "Sender / store" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :tracking_code, "Tracking code", class: "form-label" %>
      <%= f.text_field :tracking_code, class: "form-control", placeholder: "Optional" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, class: "form-control", rows: 3, placeholder: "Locker number, shelf, notes…" %>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", packages_path, class: "btn btn-ghost" %>
  </div>
<% end %>
