<%= form_with model: maintenance_request, class: "form" do |f| %>
  <%= render "shared/form_errors", object: maintenance_request %>

  <div class="form-group">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "Leaky faucet in kitchen", required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :unit_id, "Unit", class: "form-label" %>
      <%= f.collection_select :unit_id, units, :id, :label, { prompt: "Select a unit" }, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :category, class: "form-label" %>
      <%= f.select :category, MaintenanceRequest::CATEGORIES.map { |c| [c.titleize, c] }, {}, class: "form-control" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :priority, class: "form-label" %>
    <%= f.select :priority, MaintenanceRequest::PRIORITIES.map { |p| [p.capitalize, p] }, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 5, placeholder: "Describe the problem in detail", required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", (maintenance_request.persisted? ? maintenance_request : maintenance_requests_path), class: "btn btn-ghost" %>
  </div>
<% end %>
