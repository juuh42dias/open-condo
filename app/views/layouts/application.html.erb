<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? "#{yield(:title)} · OpenCondo" : "OpenCondo" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="OpenCondo — manage buildings, residents, maintenance, reservations, visitors and dues in one place.">
    <meta name="theme-color" content="#4f46e5">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="OpenCondo">
    <meta name="application-name" content="OpenCondo">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? "signed-in" : "signed-out" %>">
    <% if user_signed_in? %>
      <div class="app-shell" data-controller="layout">
        <aside class="sidebar" data-layout-target="sidebar">
          <div class="sidebar-brand">
            <%= link_to root_path, class: "brand" do %>
              <span class="brand-mark">OC</span>
              <span class="brand-text">OpenCondo</span>
            <% end %>
            <button class="icon-btn sidebar-close" data-action="layout#close" aria-label="Close menu">
              <%= icon "x", size: 20 %>
            </button>
          </div>

          <nav class="sidebar-nav">
            <p class="nav-section">Overview</p>
            <%= link_to dashboard_path, class: nav_link_class("dashboard") do %>
              <%= icon "home" %><span>Dashboard</span>
            <% end %>
            <%= link_to buildings_path, class: nav_link_class("buildings") do %>
              <%= icon "building" %><span>Buildings</span>
            <% end %>
            <%= link_to common_areas_path, class: nav_link_class("common_areas") do %>
              <%= icon "pin" %><span>Common Areas</span>
            <% end %>

            <p class="nav-section">Community</p>
            <%= link_to maintenance_requests_path, class: nav_link_class("maintenance_requests") do %>
              <%= icon "tools" %><span>Maintenance</span>
            <% end %>
            <%= link_to reservations_path, class: nav_link_class("reservations") do %>
              <%= icon "calendar" %><span>Reservations</span>
            <% end %>
            <%= link_to visitors_path, class: nav_link_class("visitors") do %>
              <%= icon "door" %><span>Visitors</span>
            <% end %>
            <%= link_to notices_path, class: nav_link_class("notices") do %>
              <%= icon "bell" %><span>Notices</span>
            <% end %>
            <%= link_to payments_path, class: nav_link_class("payments") do %>
              <%= icon "card" %><span>Payments</span>
            <% end %>
            <%= link_to packages_path, class: nav_link_class("packages") do %>
              <%= icon "package" %><span>Packages</span>
            <% end %>
            <%= link_to violations_path, class: nav_link_class("violations") do %>
              <%= icon "shield" %><span>Violations</span>
            <% end %>
            <%= link_to polls_path, class: nav_link_class("polls") do %>
              <%= icon "vote" %><span>Polls</span>
            <% end %>

            <% if current_user.admin? %>
              <p class="nav-section">Administration</p>
              <%= link_to users_path, class: nav_link_class("users") do %>
                <%= icon "users" %><span>Users</span>
              <% end %>
            <% end %>
          </nav>

          <div class="sidebar-footer">
            <div class="sidebar-user">
              <span class="avatar"><%= initials_for(current_user) %></span>
              <div class="sidebar-user-info">
                <strong><%= current_user.name %></strong>
                <span><%= current_user.role_label %></span>
              </div>
            </div>
            <%= link_to destroy_user_session_path, method: :delete, class: "nav-link nav-link-muted" do %>
              <%= icon "logout" %><span>Sign out</span>
            <% end %>
          </div>
        </aside>

        <button class="sidebar-backdrop" data-action="layout#close" aria-label="Close menu"></button>

        <div class="app-main">
          <header class="topbar">
            <button class="icon-btn menu-btn" data-action="layout#toggle" aria-label="Open menu">
              <%= icon "menu", size: 22 %>
            </button>
            <div class="topbar-title">
              <span class="topbar-brand">OpenCondo</span>
              <span class="topbar-page"><%= content_for?(:title) ? yield(:title) : "Dashboard" %></span>
            </div>
            <details class="user-menu">
              <summary class="user-menu-trigger">
                <span class="avatar"><%= initials_for(current_user) %></span>
              </summary>
              <div class="user-menu-panel">
                <div class="user-menu-header">
                  <strong><%= current_user.name %></strong>
                  <span><%= current_user.email %></span>
                  <%= badge(current_user.role_label, current_user.admin? ? :purple : :blue) %>
                </div>
                <%= link_to dashboard_path, class: "user-menu-link" do %><%= icon "home", size: 18 %> Dashboard<% end %>
                <% if current_user.admin? %>
                  <%= link_to users_path, class: "user-menu-link" do %><%= icon "users", size: 18 %> Manage users<% end %>
                <% end %>
                <%= link_to destroy_user_session_path, method: :delete, class: "user-menu-link danger" do %><%= icon "logout", size: 18 %> Sign out<% end %>
              </div>
            </details>
          </header>

          <main class="content">
            <%= render "shared/flash" %>
            <%= yield %>
          </main>
        </div>

        <nav class="bottom-nav">
          <%= link_to dashboard_path, class: "bottom-link #{'active' if nav_active?("dashboard")}" do %>
            <%= icon "home", size: 22 %><span>Home</span>
          <% end %>
          <%= link_to buildings_path, class: "bottom-link #{'active' if nav_active?("buildings")}" do %>
            <%= icon "building", size: 22 %><span>Buildings</span>
          <% end %>
          <%= link_to maintenance_requests_path, class: "bottom-link #{'active' if nav_active?("maintenance_requests")}" do %>
            <%= icon "tools", size: 22 %><span>Requests</span>
          <% end %>
          <%= link_to notices_path, class: "bottom-link #{'active' if nav_active?("notices")}" do %>
            <%= icon "bell", size: 22 %><span>Notices</span>
          <% end %>
          <%= link_to payments_path, class: "bottom-link #{'active' if nav_active?("payments")}" do %>
            <%= icon "card", size: 22 %><span>Pay</span>
          <% end %>
        </nav>
      </div>
    <% else %>
      <div class="auth-shell">
        <div class="auth-brand">
          <span class="brand-mark">OC</span>
          <span class="brand-text">OpenCondo</span>
        </div>
        <%= render "shared/flash" %>
        <%= yield %>
        <p class="auth-footer">Condominium management, simplified.</p>
      </div>
    <% end %>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).catch(function () {});
        });
      }
    </script>
  </body>
</html>
