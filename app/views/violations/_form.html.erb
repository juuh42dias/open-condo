<%= form_with model: violation, class: "form" do |f| %>
  <%= render "shared/form_errors", object: violation %>

  <div class="form-group">
    <%= f.label :unit_id, "Unit involved", class: "form-label" %>
    <%= f.collection_select :unit_id, units, :id, :label, { prompt: "Select a unit" }, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "Loud music after 10pm", required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :violation_type, "Type", class: "form-label" %>
      <%= f.select :violation_type, Violation::VIOLATION_TYPES.map { |t| [t.tr("_", " ").titleize, t] }, {}, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :severity, class: "form-label" %>
      <%= f.select :severity, Violation::SEVERITIES.map { |s| [s.capitalize, s] }, {}, class: "form-control" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "Describe what happened, when, and any evidence.", required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :fine_amount, "Proposed fine", class: "form-label" %>
      <%= f.number_field :fine_amount, class: "form-control", step: "0.01", min: 0 %>
    </div>
    <% if staff_user? %>
      <div class="form-group">
        <%= f.label :status, class: "form-label" %>
        <%= f.select :status, Violation::STATUSES.map { |s| [s.titleize, s] }, {}, class: "form-control" %>
      </div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", violations_path, class: "btn btn-ghost" %>
  </div>
<% end %>
