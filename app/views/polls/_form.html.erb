<%= form_with model: poll, class: "form" do |f| %>
  <%= render "shared/form_errors", object: poll %>

  <div class="form-group">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "Should we renovate the playground?", required: true %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :building_id, "Building", class: "form-label" %>
      <%= f.collection_select :building_id, Building.ordered, :id, :name, { prompt: "Select a building" }, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :closes_at, "Closes at", class: "form-label" %>
      <%= f.datetime_local_field :closes_at, class: "form-control" %>
      <span class="form-hint">Leave blank to keep open until closed manually.</span>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "Context, rules, quorum…" %>
  </div>

  <h3>Options</h3>
  <%= f.fields_for :poll_options do |of| %>
    <div class="form-group">
      <%= of.label :text, "Option #{of.index + 1}", class: "form-label" %>
      <div style="display:flex; gap:8px;">
        <%= of.text_field :text, class: "form-control", placeholder: "Yes / No / Option…" %>
        <% if of.object.persisted? %>
          <label style="display:flex; align-items:center; gap:4px; font-size:13px;">
            <%= of.check_box :_destroy %> Remove
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", polls_path, class: "btn btn-ghost" %>
  </div>
<% end %>
