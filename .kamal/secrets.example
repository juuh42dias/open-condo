# Kamal secrets for OpenCondo. NEVER commit this file (it is gitignored).
# Copy from the checked-in example:
#   cp .kamal/secrets.example .kamal/secrets
# Then fill in real values:
#
# KAMAL_REGISTRY_PASSWORD  - Docker Hub personal access token (Read & Write)
# RAILS_MASTER_KEY          - copy from config/master.key
# OPEN_CONDO_DATABASE_PASSWORD - pick a strong password for the production DB...
# POSTGRES_PASSWORD            - ...and paste the SAME password here for the db accessory

KAMAL_REGISTRY_PASSWORD=PASTE_DOCKER_HUB_TOKEN
RAILS_MASTER_KEY=PASTE_FROM_CONFIG_MASTER_KEY
OPEN_CONDO_DATABASE_PASSWORD=PASTE_STRONG_PASSWORD
POSTGRES_PASSWORD=PASTE_SAME_STRONG_PASSWORD
