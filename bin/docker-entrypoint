#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency (if available).
if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit 2>/dev/null)
  export LD_PRELOAD
fi

# If running the rails server then prepare the database automatically.
if [[ "$*" == *"./bin/rails server"* ]]; then
  ./bin/rails db:prepare
fi

exec "${@}"
